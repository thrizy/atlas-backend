{
  "name": "atlas-marketdata-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Atlas market-data gateway — proxies Databento (CME GLBX.MDP3) history + live to Waves. Holds the Databento key server-side.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node --loader tsx dist/server.js || tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2"
  }
}
