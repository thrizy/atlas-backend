# Databento market-data gateway — copy to .env and fill in.

# Databento API key (from databento.com → API keys). Server-side ONLY.
DATABENTO_API_KEY=

# CME Globex dataset (covers CME + CBOT + NYMEX + COMEX). Leave as-is.
DATABENTO_DATASET=GLBX.MDP3

# Databento input symbology. "raw_symbol" = the exchange's native contract symbol
# (e.g. ESM6). Verify against your symbols in the Databento symbology docs.
DATABENTO_STYPE_IN=raw_symbol

# HTTP port
PORT=8080

# CORS origin allowed to call /bars (the Waves app). Use the real origin in prod,
# e.g. https://waves.myatlasfund.com  ("*" only for local dev).
GATEWAY_ALLOWED_ORIGIN=*

# Seconds between live-bar polls (placeholder live source — see live.ts).
LIVE_POLL_SECONDS=3
